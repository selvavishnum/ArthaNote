rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.uid == 'WpCQtDGJkpOXJfWntS6vu3B5HXO2';
    }

    function myBusinessId() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.businessId;
    }

    function ownsBusiness(bid) {
      return request.auth != null &&
        (request.auth.uid == bid || myBusinessId() == bid);
    }

    // Staff documents come in two shapes:
    //  1. Self profile docs, keyed by the doc owner's own auth uid — always
    //     carry a 'uid' field. Only that owner (or admin) may write it.
    //  2. Staff-access grant docs (auto-ID, created by grantStaffAccess /
    //     the "Add Staff" dialog) — never carry a 'uid' field. Only the
    //     business owner who created the grant (businessId == their own
    //     uid) may manage it. This keeps any authenticated user from being
    //     able to overwrite someone else's businessId and hijack their data.
    match /staff/{docId} {
      // ⚠️ WORLD-READABLE. This is the biggest remaining hole: anyone on the
      // internet can list every staff doc of every business — names, emails,
      // businessIds, and on owner self-profile docs the billing fields
      // (pro / planType / proExpiry / lastPaymentId) too.
      //
      // It is open because attend.html (QR, no login) queries
      //   staff.where('businessId','==',BID)
      // and an unauthenticated client has no identity to match a rule against.
      //
      // TO CLOSE IT, in this order — flipping it early breaks attendance for
      // every shop, so do not reorder:
      //   1. Firebase Console → Authentication → Sign-in method → enable
      //      "Anonymous".
      //   2. Deploy the attend.html that calls ensureAnonAuth() (already in
      //      this repo) and confirm a real QR scan still lists staff.
      //   3. Only then change the line below to:
      //         allow read: if request.auth != null;
      //      and re-test one QR scan immediately after publishing.
      // That stops anonymous internet-wide scraping. It does not stop a
      // determined attacker who mints their own anonymous token, so the
      // durable fix is to stop keeping email/billing fields on a doc this
      // page needs to read — split the roster (businessId, name, shop) into
      // its own collection and lock this one to ownsBusiness().
      allow read: if true;

      allow create: if isAdmin() || (request.auth != null && (
        (docId == request.auth.uid && request.resource.data.uid == request.auth.uid) ||
        (!('uid' in request.resource.data) &&
          request.resource.data.businessId == request.auth.uid)
      ));

      // The doc's own owner (matched by uid field, never by docId alone) may
      // always update/delete it. A business owner may also manage any staff
      // doc filed under their businessId — for assigning shop/role to staff,
      // including staff who already self-linked — but an update may never
      // change the doc's businessId or uid (that's the field that grants
      // access, and must stay under the control of the doc's own owner /
      // the verified-grant flow in setManualBusinessId only).
      allow update: if isAdmin() || (request.auth != null && (
        resource.data.uid == request.auth.uid ||
        (ownsBusiness(resource.data.businessId) &&
          request.resource.data.businessId == resource.data.businessId &&
          request.resource.data.get('uid', null) == resource.data.get('uid', null))
      ));

      allow delete: if isAdmin() || (request.auth != null && (
        resource.data.uid == request.auth.uid ||
        ownsBusiness(resource.data.businessId)
      ));
    }

    // Attendance — the QR scan page (attend.html) has no login, so reads and
    // new marks stay open. `write: if true` used to cover update and delete
    // too, which meant anyone on the internet could rewrite or wipe any
    // business's entire attendance history, and could write arbitrary
    // documents into this collection. Both are now closed.
    match /attendance/{docId} {
      allow read: if true;

      // Append-only, and shape-checked so the open endpoint can only be used
      // to record attendance. All three writers — attend.html (staff + manager
      // paths), the Flutter QR screen and the Flutter staff screen — send
      // exactly these fields, so this rejects nothing the app actually does.
      allow create: if request.resource.data.keys().hasAll(
            ['businessId','shopId','staffName','date','time','timeRaw','type'])
        && request.resource.data.businessId is string
        && request.resource.data.businessId.size() > 0
        && request.resource.data.businessId.size() <= 128
        && request.resource.data.staffName is string
        && request.resource.data.staffName.size() > 0
        && request.resource.data.staffName.size() <= 120
        && request.resource.data.date is string
        && request.resource.data.date.size() <= 10
        && request.resource.data.time is string
        && request.resource.data.time.size() <= 20
        // int OR float: both clients send an integer epoch, but a rule that
        // insisted on `is int` would block every staff member from marking
        // attendance if a client ever serialised it as a double. Failing open
        // on the number type is the safe side of that trade.
        && (request.resource.data.timeRaw is int || request.resource.data.timeRaw is float)
        && request.resource.data.type in ['in','out','rest','back','half'];

      // Editing or deleting a mark is not part of the no-login QR flow. The
      // owning business does it in-app; the admin purge does it on deletion.
      allow update, delete: if isAdmin() || ownsBusiness(resource.data.businessId);
    }

    // Config (shops, bizType, GST) — business owner only
    match /config/{businessId} {
      allow read, write: if isAdmin() || ownsBusiness(businessId);
    }

    // Transactions
    match /transactions/{docId} {
      allow read, update, delete: if isAdmin() || ownsBusiness(resource.data.businessId);
      allow create: if isAdmin() || ownsBusiness(request.resource.data.businessId);
    }

    // Suppliers
    match /suppliers/{docId} {
      allow read, update, delete: if isAdmin() || ownsBusiness(resource.data.businessId);
      allow create: if isAdmin() || ownsBusiness(request.resource.data.businessId);
    }

    // Supplier bills (Flutter app collection)
    match /supplier_bills/{docId} {
      allow read, update, delete: if isAdmin() || ownsBusiness(resource.data.businessId);
      allow create: if isAdmin() || ownsBusiness(request.resource.data.businessId);
    }

    // Supplier bills (WEBSITE collection — index.html writes to 'sup_bills',
    // not 'supplier_bills'; without this rule every website bill/payment
    // write would be denied under these rules)
    match /sup_bills/{docId} {
      allow read, update, delete: if isAdmin() || ownsBusiness(resource.data.businessId);
      allow create: if isAdmin() || ownsBusiness(request.resource.data.businessId);
    }

    // Stock register (website Suppliers → 📦 Stock) — product items and the
    // FIFO in/out movement log
    match /stock_items/{docId} {
      allow read, update, delete: if isAdmin() || ownsBusiness(resource.data.businessId);
      allow create: if isAdmin() || ownsBusiness(request.resource.data.businessId);
    }

    match /stock_moves/{docId} {
      allow read, update, delete: if isAdmin() || ownsBusiness(resource.data.businessId);
      allow create: if isAdmin() || ownsBusiness(request.resource.data.businessId);
    }

    // Finance — members, payments, chits
    match /fc_members/{docId} {
      allow read, update, delete: if isAdmin() || ownsBusiness(resource.data.businessId);
      allow create: if isAdmin() || ownsBusiness(request.resource.data.businessId);
    }

    match /fc_payments/{docId} {
      allow read, update, delete: if isAdmin() || ownsBusiness(resource.data.businessId);
      allow create: if isAdmin() || ownsBusiness(request.resource.data.businessId);
    }

    match /fc_chits/{docId} {
      allow read, update, delete: if isAdmin() || ownsBusiness(resource.data.businessId);
      allow create: if isAdmin() || ownsBusiness(request.resource.data.businessId);
    }

    // Construction — projects & their ledger entries
    match /construction_projects/{docId} {
      allow read, update, delete: if isAdmin() || ownsBusiness(resource.data.businessId);
      allow create: if isAdmin() || ownsBusiness(request.resource.data.businessId);
    }

    match /construction_entries/{docId} {
      allow read, update, delete: if isAdmin() || ownsBusiness(resource.data.businessId);
      allow create: if isAdmin() || ownsBusiness(request.resource.data.businessId);
    }

    // ── POS ────────────────────────────────────────────────────────────
    // Deliberately separate from `transactions`. POS is new and will have
    // bugs; keeping it out of the collection 369 live businesses depend on
    // means a POS defect cannot corrupt ledger data. The day's total is
    // rolled up into one `transactions` entry, so the Android ledger app,
    // the reports and the admin panel keep working with no change at all.

    // One document per bill. At 4 shops x 500 bills/day that is ~60k writes
    // a month (~₹9) — cheap enough that packing bills into day-documents to
    // save writes would only buy multi-terminal write conflicts and a 1MB
    // ceiling. Bills are immutable once written: a mistake is corrected with
    // a return, never by editing history.
    match /pos_bills/{docId} {
      allow read:   if isAdmin() || ownsBusiness(resource.data.businessId);
      allow create: if isAdmin() || (ownsBusiness(request.resource.data.businessId)
                       && request.resource.data.businessId is string
                       && request.resource.data.shopId is string
                       && request.resource.data.total is number
                       && request.resource.data.total >= 0);
      allow update, delete: if isAdmin();
    }

    // One document per shop per day, incremented as bills sync. This is what
    // reports read: a 90-day report is 90 documents instead of ~45,000 bills.
    // Writes are increments, so two terminals updating the same day are safe.
    match /pos_rollups/{docId} {
      allow read:  if isAdmin() || ownsBusiness(resource.data.businessId);
      allow create: if isAdmin() || ownsBusiness(request.resource.data.businessId);
      allow update: if isAdmin() || ownsBusiness(resource.data.businessId);
      allow delete: if isAdmin();
    }

    // Promo codes — you (admin) create/delete them; any signed-in user may read
    // a code to validate it and, when redeeming, update ONLY the usage fields
    // (usedCount / usedBy). This stops casual tampering with planType/maxUses/
    // expiresAt via the redemption path. (The Pro grant itself is written to the
    // user's own staff doc, same client-trust model as the trial.)
    match /promo_codes/{code} {
      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['usedCount', 'usedBy'])
      );
    }

    // Audit log — the web app writes login/save/edit events here and the
    // admin Activity Log reads them. There was NO rule for this collection,
    // so every write/read was silently rejected and the admin page showed
    // "Error loading activity" (no match = deny).
    match /audit/{docId} {
      allow create: if request.auth != null;
      allow read: if isAdmin() || ownsBusiness(resource.data.businessId);
      allow update, delete: if isAdmin();
    }

    // Billing anomalies — write-only audit log from BillingService when a
    // restored/purchased Play Billing purchase is tagged for a different
    // Firebase user than whoever is logged in (cross-account leak guard).
    // Any signed-in user can log one (it's just a client detecting its own
    // mismatch), nobody but the admin can read/change the log afterward.
    match /billing_anomalies/{docId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isAdmin();
    }

    // Web delete-account form (delete-account.html) — submitted WITHOUT
    // login, so create must be public. Without this rule every submission
    // was silently rejected (no match = deny). Admin reviews in the panel.
    match /deletion_requests/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Admin-made snapshots of accounts in the deletion grace window —
    // name/shops/txn summary kept for records after the final purge.
    match /deleted_accounts/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
